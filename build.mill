object v {
  val native     = "0.5.13-20261114-143517b-SNAPSHOT"
  val nativeRepo = "https://central.sonatype.com/repository/maven-snapshots"
  val scala      = "3.8.4"
  val mainargs   = mvn"com.lihaoyi::mainargs::0.7.6"
  val oslib      = mvn"com.lihaoyi::os-lib::0.11.3"
  val upickle    = mvn"com.lihaoyi::upickle::4.0.2"
  val utest      = mvn"com.lihaoyi::utest::0.8.4"
  val sourcecode = mvn"com.lihaoyi::sourcecode::0.4.2"
  val fastparse  = mvn"com.lihaoyi::fastparse::3.1.1"
  val pprint     = mvn"com.lihaoyi::pprint::0.9.0"
}

trait NativeModule extends ScalaNativeModule { outer =>
  override def repositories         = Task(super.repositories() :+ v.nativeRepo)
  override def nativeMultithreading = Task(Some(true): Option[Boolean])

  def scalaVersion                  = Task(v.scala)
  def scalaNativeVersion            = Task(v.native)
  def nativeInstalls                = Task.Input(
    Seq("MLIR_INSTALL_PATH", "CIRCT_INSTALL_PATH").flatMap(Task.env.get).map(os.Path(_))
  )
  override def nativeCompileOptions = Task(
    super.nativeCompileOptions() ++ nativeInstalls().map(p => s"-I${p / "include"}")
  )
  override def nativeLinkingOptions = Task(
    super.nativeLinkingOptions() ++ nativeInstalls().flatMap(p => Seq(s"-L${p / "lib"}", s"-Wl,-rpath,${p / "lib"}"))
  )
  override def nativeEmbedResources = Task(true)
  trait NativeTests extends ScalaNativeTests {
    def testEnvironment               = Task.Input(Task.env.view.filterKeys(Set("PATH", "Z3_LIB")).toMap)
    override def forkEnv              = Task(super.forkEnv() ++ testEnvironment())
    override def repositories         = outer.repositories()
    override def nativeMultithreading = outer.nativeMultithreading()
    override def nativeCompileOptions = outer.nativeCompileOptions()
    override def nativeLinkingOptions = outer.nativeLinkingOptions()
    override def nativeEmbedResources = outer.nativeEmbedResources()
  }
}

trait ZaoziScalaModule extends NativeModule {
  override def scalacOptions: T[Seq[String]] = Task(
    super.scalacOptions() ++ Seq(
      // Emit SemanticDB so the project can be indexed by SemanticDB-based
      // tooling (Metals, scalafix, scala3-bsp-semantic-ls). Built into the
      // Scala 3 compiler; -sourceroot keeps emitted URIs workspace-relative.
      "-Xsemanticdb",
      "-sourceroot",
      mill.api.BuildCtx.workspaceRoot.toString,
      // Load the zaozi SemanticDB-enhancer plugin into every DSL module so
      // bundle fields accessed through scala.Dynamic get real occurrences in
      // the emitted SemanticDB. Mill only synthesizes -Xplugin flags for
      // scalacPluginMvnDeps (published plugins), so a workspace-local plugin
      // module is wired through its jar explicitly; ScalaTests forwards
      // scalacOptions, so test modules inherit the plugin as well.
      s"-Xplugin:${build.`zaozi-compiler-plugin`.jar().path}"
    )
  )

  // Also expose the plugin jar as a content-hashed input: the -Xplugin string
  // above is path-only, so without this a plugin rebuild would not invalidate
  // downstream compiles (mill hashes scalacPluginClasspath PathRefs into the
  // compile inputs and zinc's compiler cache key).
  override def scalacPluginClasspath: T[Seq[PathRef]] = Task(
    super.scalacPluginClasspath() ++ Seq(build.`zaozi-compiler-plugin`.jar())
  )
}

trait ZaoziPublishModule extends PublishModule {
  def publishVersion: mill.T[String] = "0.0.1-SNAPSHOT"

  def pomSettings = Task(
    PomSettings(
      description = artifactName(),
      organization = "me.jiuyang",
      url = "https://github.com/sequencer/zaozi",
      licenses = Seq(License.`Apache-2.0`),
      versionControl = VersionControl.github("sequencer", "zaozi"),
      developers = Seq(
        Developer("sequencer", "Jiuyang Liu", "https://github.com/sequencer"),
        Developer("unlsycn", "Yuhang Zeng", "https://github.com/unlsycn"),
        Developer("Clo91eaf", "Jianhao Ye", "https://github.com/Clo91eaf")
      )
    )
  )
}

trait RawBindingsModule extends NativeModule with ZaoziPublishModule {
  def group: String
  def install                   = Task.Input(os.Path(Task.env(group.toUpperCase + "_INSTALL_PATH")))
  def generator                 = Task.Source(mill.api.BuildCtx.workspaceRoot / "native" / "bindings.py")
  def header                    = Task.Source(moduleDir / os.up / "capi" / "native.h")
  def bindgen                   = Task.Input(Task.env.getOrElse("SN_BINDGEN", "bindgen"))
  def clangCommand              = Task.Input(Task.env.getOrElse("CLANG", "clang"))
  def systemIncludes            = Task.Input(Task.env.get("LIBC_INCLUDE_PATH").toSeq)
  def bindings                  = Task {
    val inc = nativeInstalls().map(p => (p / "include").toString) ++ systemIncludes()
    os.proc(
      Seq(
        "python3",
        generator().path.toString,
        group,
        header().path.toString,
        Task.dest.toString,
        "--binary",
        bindgen(),
        "--clang",
        clangCommand(),
        "--library-dir",
        (install() / "lib").toString
      ) ++
        inc.flatMap(p => Seq("--include", p))
    ).call()
    PathRef(Task.dest)
  }
  override def generatedSources = Task(super.generatedSources() :+ PathRef(bindings().path / "src"))
  override def resources        = Task(super.resources() :+ PathRef(bindings().path / "resources"))
}

// Lit-based Test
trait LitModule extends Module {
  def scalaVersion:   T[String]
  def runClasspath:   T[Seq[os.Path]]
  def nativeInstalls: T[Seq[os.Path]]
  def litDir:         T[os.Path]
  def litConfigIn:    T[PathRef]
  def z3Lib:          T[String]  = Task.Input(Task.env.getOrElse("Z3_LIB", ""))
  def litConfig:      T[PathRef] = Task {
    os.write(
      Task.dest / "lit.site.cfg.py",
      os.read(litConfigIn().path)
        .replaceAll("@SCALA_VERSION@", scalaVersion())
        .replaceAll("@RUN_CLASSPATH@", runClasspath().mkString(","))
        .replace("@NATIVE_VERSION@", v.native)
        .replace("@NATIVE_REPO@", v.nativeRepo)
        .replace("@NATIVE_INSTALLS@", nativeInstalls().mkString(","))
        .replaceAll("@LIT_DIR@", litDir().toString)
        .replaceAll("@Z3_LIB@", z3Lib())
    )
    PathRef(Task.dest)
  }
  def litBinary          = Task.Input(
    os.Path(
      Task.env.getOrElse("LIT_INSTALL_PATH", "LIT_INSTALL_PATH not found, you are not in the nix env?")
    ) / "bin" / "lit"
  )
  def run(args: String*) = Task.Command(
    os.proc(Seq(litBinary().toString(), litConfig().path.toString, "-a") ++ args)
      .call(Task.dest, stdout = os.ProcessOutput.Readlines(line => Task.ctx().log.info("[lit] " + line)))
  )
}
