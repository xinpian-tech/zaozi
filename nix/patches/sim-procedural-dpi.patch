diff --git a/test/Conversion/SimToSV/dpi-procedural.mlir b/test/Conversion/SimToSV/dpi-procedural.mlir
new file mode 100644
index 000000000..846246a1c
--- /dev/null
+++ b/test/Conversion/SimToSV/dpi-procedural.mlir
@@ -0,0 +1,56 @@
+// RUN: circt-opt %s --canonicalize --cse --lower-sim-to-sv | FileCheck %s
+// RUN: circt-opt %s --canonicalize --cse --lower-sim-to-sv --lower-seq-to-sv --export-verilog | FileCheck %s --check-prefix=SV
+
+sim.func.dpi @begin_cycle()
+sim.func.dpi @sample(in %data: i32, out result: i32, return status: i32)
+sim.func.dpi @consume(in %data: i32, in %status: i32)
+sim.func.dpi @end_cycle()
+
+// CHECK-LABEL: hw.module @ordered
+// SV-LABEL: module ordered(
+hw.module @ordered(in %clock: !seq.clock, in %enable: i1, in %data: i32, out result: i32) {
+  %result = sv.reg : !hw.inout<i32>
+  sim.triggered %clock if %enable {
+    // CHECK: sv.always posedge
+    // CHECK-NEXT: sv.if %enable {
+    // CHECK-NEXT: sv.func.call.procedural @begin_cycle()
+    // CHECK-NEXT: %[[RESULT:.*]]:2 = sv.func.call.procedural @sample(%data)
+    // CHECK-NEXT: sv.func.call.procedural @consume(%[[RESULT]]#0, %[[RESULT]]#1)
+    // CHECK-NEXT: sv.func.call.procedural @end_cycle()
+    // CHECK-NEXT: sv.passign %result, %[[RESULT]]#0
+    // CHECK-NEXT: }
+    // CHECK-NEXT: }
+    // CHECK-NOT: sv.always
+    sim.proc.dpi.call @begin_cycle() : () -> ()
+    %value, %status = sim.proc.dpi.call @sample(%data) : (i32) -> (i32, i32)
+    sim.proc.dpi.call @consume(%value, %status) : (i32, i32) -> ()
+    sim.proc.dpi.call @end_cycle() : () -> ()
+    sv.passign %result, %value : i32
+  }
+  %read = sv.read_inout %result : !hw.inout<i32>
+  hw.output %read : i32
+}
+
+// SV: always @(posedge clock) begin
+// SV-NEXT: if (enable) begin
+// SV-NEXT: begin_cycle();
+// SV-NEXT: [[STATUS:[a-zA-Z_][a-zA-Z_0-9]*]] = sample(data, [[VALUE:[a-zA-Z_][a-zA-Z_0-9]*]]);
+// SV-NEXT: consume([[VALUE]], [[STATUS]]);
+// SV-NEXT: end_cycle();
+// SV-NEXT: result{{.*}} <= [[VALUE]];
+// SV-NEXT: end
+// SV-NEXT: end
+// SV-NOT: {{^ *}}always @
+// SV: endmodule
+
+// CHECK-LABEL: hw.module @unconditional
+hw.module @unconditional(in %clock: !seq.clock) {
+  sim.triggered %clock {
+    // CHECK: sv.always posedge
+    // CHECK-NEXT: sv.func.call.procedural @begin_cycle()
+    // CHECK-NEXT: sv.func.call.procedural @end_cycle()
+    // CHECK-NEXT: }
+    sim.proc.dpi.call @begin_cycle() : () -> ()
+    sim.proc.dpi.call @end_cycle() : () -> ()
+  }
+}
diff --git a/test/Dialect/Sim/dpi-procedural-errors.mlir b/test/Dialect/Sim/dpi-procedural-errors.mlir
new file mode 100644
index 000000000..b94170d1c
--- /dev/null
+++ b/test/Dialect/Sim/dpi-procedural-errors.mlir
@@ -0,0 +1,56 @@
+// RUN: circt-opt %s --split-input-file --verify-diagnostics
+
+sim.func.dpi @step()
+hw.module @outside() {
+  // expected-error @below {{must not be in a non-procedural region}}
+  sim.proc.dpi.call @step() : () -> ()
+}
+
+// -----
+
+hw.module @missing(in %clock: !seq.clock) {
+  sim.triggered %clock {
+    // expected-error @below {{cannot find function declaration 'absent'}}
+    sim.proc.dpi.call @absent() : () -> ()
+  }
+}
+
+// -----
+
+sim.func.dpi @step(in %x: i8, return result: i8)
+hw.module @wrong_inputs(in %clock: !seq.clock) {
+  sim.triggered %clock {
+    // expected-error @below {{expects 1 DPI operands, but got 0}}
+    %result = sim.proc.dpi.call @step() : () -> i8
+  }
+}
+
+// -----
+
+sim.func.dpi @step(in %x: i8, return result: i8)
+hw.module @wrong_results(in %clock: !seq.clock, in %x: i8) {
+  sim.triggered %clock {
+    // expected-error @below {{expects 1 DPI results, but got 0}}
+    sim.proc.dpi.call @step(%x) : (i8) -> ()
+  }
+}
+
+// -----
+
+sim.func.dpi @step(in %x: i8, return result: i8)
+hw.module @wrong_type(in %clock: !seq.clock, in %x: i1) {
+  sim.triggered %clock {
+    // expected-error @below {{operand type mismatch: expected 'i8', but got 'i1'}}
+    %result = sim.proc.dpi.call @step(%x) : (i1) -> i8
+  }
+}
+
+// -----
+
+sim.func.dpi @step(in %x: i8, return result: i8)
+hw.module @wrong_result_type(in %clock: !seq.clock, in %x: i8) {
+  sim.triggered %clock {
+    // expected-error @below {{result type mismatch: expected 'i8', but got 'i1'}}
+    %result = sim.proc.dpi.call @step(%x) : (i8) -> i1
+  }
+}
