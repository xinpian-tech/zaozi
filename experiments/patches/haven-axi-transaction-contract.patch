+  function new(string name="transport_sequence"); super.new(name); endfunction
+  task body();
+    synthetic_seq_item txn;
+    txn = synthetic_seq_item::type_id::create("write");
+    start_item(txn);
+    if (!txn.randomize() with {write_op == 1; pin_0 == 16'h34; pin_3 == 32'h12345678; pin_6 == 4'h5;})
+      `uvm_fatal("RAND", "payload randomization failed")
+    finish_item(txn);
+    txn = synthetic_seq_item::type_id::create("read");
+    start_item(txn);
+    if (!txn.randomize() with {write_op == 0; pin_10 == 16'h38;})
+      `uvm_fatal("RAND", "read randomization failed")
+    finish_item(txn);
+    if (txn.pin_13 !== 32'habcdef01) `uvm_fatal("READ", "read data not returned to item")
+  endtask
+endclass
