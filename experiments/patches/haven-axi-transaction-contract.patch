@@ -0,0 +1,51 @@
+"""One sequence transaction, disjoint active pin owners; no new stimulus agent."""
+from copy import deepcopy
+import re
+
+
+def install_dispatch(components, blueprint):
+    contract = blueprint.get('sequence_dispatch')
+    if not contract:
+        return components
+    if contract.get('version') != 'broadcast-disjoint-pins-v1':
+        raise ValueError('unsupported sequence dispatch contract')
+    result = deepcopy(components)
+    module = blueprint['module_name']
+    item_type = module+'_seq_item'
+    primary = contract['primary']+'__driver'
+    if 'env_dispatch_' in result[primary]:
+        raise ValueError('sequence dispatch already installed')
+    from haven.utils.field_extractor import parse_seq_item_fields
+    fields = parse_seq_item_fields(result['seq_item']).all_names
+    agents = {a['name']:a for a in blueprint['topology']['agents']}
+    for name in contract['secondary']:
+        missing = set(agents[name]['input_signals']) - fields
+        if missing: raise ValueError('secondary agent fields absent from shared seq_item: '+str(sorted(missing)))
+    declarations, enqueue, wait = [], [], []
+    for name in contract['secondary']:
+        prefix = module+'_env_dispatch_'+name
+        declarations += [f'mailbox #({item_type}) {prefix}_requests = new;',
+                         f'mailbox #(bit) {prefix}_done = new;']
+        copies = '\n'.join(f'copy.{field} = item.{field};' for field in sorted(fields))
+        enqueue.append(f'begin {item_type} copy; copy = new("dispatch_copy"); {copies}\n{prefix}_requests.put(copy); end')
+        wait.append(f'begin bit done; {prefix}_done.get(done); end')
+        code = result[name+'__driver']
+        calls = re.findall(r'seq_item_port\.get_next_item\((\w+)\);',code)
+        if len(calls)!=1 or code.count('seq_item_port.item_done();')!=1:
+            raise ValueError('secondary driver needs one get/item_done transaction loop')
+        code = code.replace(f'seq_item_port.get_next_item({calls[0]});',f'{prefix}_requests.get({calls[0]});')
+        result[name+'__driver'] = code.replace('seq_item_port.item_done();',f'{prefix}_done.put(1);')
+    code = result[primary]
+    calls = re.findall(r'seq_item_port\.get_next_item\((\w+)\);',code)
+    if len(calls)!=1 or code.count('seq_item_port.item_done();')!=1:
+        raise ValueError('primary driver needs one get/item_done transaction loop')
+    var = calls[0]
+    code = code.replace(f'seq_item_port.get_next_item({var});',
+                        f'seq_item_port.get_next_item({var});\n env_dispatch_send({var});')
+    code = code.replace('seq_item_port.item_done();','env_dispatch_wait();\nseq_item_port.item_done();')
+    if code.count('endclass')!=1: raise ValueError('expected one primary driver class')
+    tasks = (f'task env_dispatch_send({item_type} item);\n'+'\n'.join(enqueue)+'\nendtask\n'+
+             'task env_dispatch_wait();\n'+'\n'.join(wait)+'\nendtask\n')
+    result[primary] = code.replace('endclass',tasks+'endclass')
+    result['seq_item'] += '\n'+'\n'.join(declarations)+'\n'
+    return result
