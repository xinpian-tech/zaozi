+from copy import deepcopy
+import pytest
+from haven.utils.environment_contract import normalize_environment, validate_driver_ownership
+from haven.utils.template_engine import TemplateEngine
+
+
+def test_static_literals_normalize_without_truncation_or_unknown_values():
+    from haven.utils.environment_contract import static_integer
+    for value,width,expected in [("13'h0033",13,51),("3'd4",3,4),("'1",5,31),("'0",1,0),("1_024",12,1024)]:
+        assert static_integer(value,width)==expected
+    for value,width in [("2'd4",4),("4'hf",3),("1'bx",1),(True,1),("-1",4),("a | b",4)]:
+        with pytest.raises(ValueError): static_integer(value,width)
+
+
+def test_bfm_named_secondary_clock_is_not_silently_primary():
+    bp=normalize_environment(blueprint())
+    bp['clock_schedule']=[{'port':'clk','period_ps':10000},{'port':'mem_clk','period_ps':6000}]
+    bp['io_specification']['inputs'].append({'name':'mem_clk','width':1})
+    bp['bfm_configs'][0]['params']['clock_domain']='mem_clk'
+    code=TemplateEngine().render('top',bp)
+    assert '.clk(env_clock_mem_clk)' in code
+    bp['bfm_configs'][0]['params']['clock_domain']='not_a_clock'
+    with pytest.raises(ValueError,match='declared clock'):
+        TemplateEngine().render('top',bp)
+
+
+def test_driver_ownership_repair_is_bounded_and_revalidated():
+    from types import SimpleNamespace
+    from haven.phases.testbench_generator import TestbenchGenerator
+    bp = normalize_environment(blueprint())
+    agent = bp['topology']['agents'][0]
+    generator = TestbenchGenerator.__new__(TestbenchGenerator)
+    prompts = []
+    def repair(prompt, schema):
+        prompts.append(prompt)
+        return SimpleNamespace(code='vif.side_i <= 1;')
+    generator.llm = SimpleNamespace(call_structured=repair)
+    assert generator._repair_driver_ownership('vif.rx_i <= 1;', agent, bp) == 'vif.side_i <= 1;'
+    assert len(prompts) == 1 and 'declared owner is bfm:uart_serial' in prompts[0]
+    prompts.clear()
+    assert generator._repair_driver_ownership('vif.side_i <= 1;', agent, bp)
+    assert not prompts
+    def bad_repair(prompt, schema):
+        prompts.append(prompt)
+        return SimpleNamespace(code='vif.rx_i <= 1;')
+    generator.llm = SimpleNamespace(call_structured=bad_repair)
+    with pytest.raises(ValueError, match='after bounded repairs'):
+        generator._repair_driver_ownership('vif.rx_i <= 1;', agent, bp)
+    assert len(prompts) == 2
+
+
+def test_config_rejects_uninstalled_bfm_before_later_phases():
+    from types import SimpleNamespace
+    from unittest.mock import Mock
+    from haven.phases.config_generator import ConfigGenerator
+    invalid = {'bfm_configs': [{'protocol': 'invented_protocol'}]}
+    valid = {'bfm_configs': []}
+    call = Mock(side_effect=[invalid, valid])
+    llm = SimpleNamespace(load_prompt=lambda _: '{spec_text}\n{rtl_ports}', call=call)
+    assert ConfigGenerator._llm_extract(llm, 'generic spec', 'ports') == valid
+    assert call.call_count == 2
+    assert 'Installed BFM protocols (exhaustive)' in call.call_args_list[0].args[0]
+    assert 'unavailable BFM: invented_protocol' in call.call_args_list[1].args[0]
+    call.side_effect = [invalid] * 3
+    with pytest.raises(ValueError, match='Invalid Phase-0 environment'):
+        ConfigGenerator._llm_extract(llm, 'generic spec', 'ports')
+
+
+def blueprint():
+    return {'module_name': 'probe', 'clock': {'port': 'clk'}, 'reset': {'name': 'rst', 'level': 'high'},
+            'io_specification': {'inputs': [{'name': 'rx_i', 'width': 1}, {'name': 'side_i', 'width': 1}],
+                                 'outputs': [{'name': 'tx_o', 'width': 1}], 'inouts': []},
+            'topology': {'agents': [{'name': 'serial', 'mode': 'master',
