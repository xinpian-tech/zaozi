diff --git a/src/haven/utils/json_output.py b/src/haven/utils/json_output.py
new file mode 100644
--- /dev/null
+++ b/src/haven/utils/json_output.py
@@ -0,0 +1,42 @@
+"""Decode JSON with value-preserving normalization of known integer literals."""
+import json
+import re
+
+
+_TOKEN = re.compile(r'''"(?:\\.|[^"\\])*"|(?P<hex>(?<![\w.])-?0[xX][0-9a-fA-F]+)(?=\s*[,}\]])|(?P<sv>(?<![\w.\-])(?P<width>[1-9]\d*)'(?P<base>[hHdDbBoO])(?P<digits>[0-9a-fA-F_]+))(?=\s*[,}\]])''')
+
+
+def _number(match):
+    try:
+        if match['hex']:
+            return str(int(match['hex'],16))
+        if match['sv']:
+            width = int(match['width'])
+            value = int(match['digits'].replace('_',''),{'h':16,'d':10,'b':2,'o':8}[match['base'].lower()])
+            # No signed, X/Z, overflowing, or unbounded SV literal coercions.
+            if width <= 4096 and value.bit_length() <= width:
+                return str(value)
+    except ValueError:
+        pass
+    return match[0]
+
+
+def loads(text):
+    try:
+        value = json.loads(text)
+    except json.JSONDecodeError:
+        # Never change strings, names, expressions, comments or control flow.
+        # Only bare hexadecimal or known unsigned sized SV integers may be
+        # normalized; the entire result must still parse as JSON.
+        normalized = _TOKEN.sub(_number, text)
+        value = json.loads(normalized)
+    # Some providers return a typed JSON envelope as the response body. Decode
+    # only this exact shape; arbitrary application "content" fields are data.
+    if isinstance(value, dict) and set(value) == {'type', 'content'} and value['type'] == 'json_object':
+        payload = value['content']
+        if isinstance(payload, str):
+            payload = json.loads(payload)
+        if not isinstance(payload, dict):
+            raise ValueError('json_object response content must be an object')
+        return payload
+    return value
