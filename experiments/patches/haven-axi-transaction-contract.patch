+++ b/src/haven/utils/bfm_api.py
@@ -0,0 +1,63 @@
+"""Callable BFM API derived from installed source, not benchmark scenarios."""
+import re
+from haven.dsl.schema import BFMConfig
+from haven.utils.bfm_renderer import BFMRenderer
+
+
+def extract(sources):
+    result = {}
+    for protocol, source in sources.items():
+        source = re.sub(r'//[^\n]*|/\*.*?\*/', ' ', source, flags=re.S)
+        tasks = {}
+        for match in re.finditer(r'\btask\s+(?:(?:automatic|static)\s+)?(\w+)\s*\((.*?)\)\s*;', source, re.S):
+            params = []
+            for param in match[2].split(',') if match[2].strip() else []:
+                found = re.fullmatch(r'\s*(input|output|inout)\s+(.+?)\s+(\w+)\s*',param,re.S)
+                if not found:
+                    raise ValueError('unsupported BFM task signature: '+match[1])
+                params.append({'name':found[3],'direction':found[1],'type':' '.join(found[2].split())})
+            tasks[match[1]] = params
+        result[protocol] = tasks
+    return result
+
+
+def available(configs):
+    sources = {}
+    for config in configs or []:
+        bfm = BFMConfig(**config) if isinstance(config,dict) else config
+        if bfm.protocol in sources:
+            raise ValueError('DSL BFM protocol reference is ambiguous across multiple instances')
+        sources[bfm.protocol] = BFMRenderer().render(bfm)
+    return extract(sources)
+
+
+def owned_fields(configs):
+    """Map actual BFM output/inout declarations to DUT transaction field names."""
+    from haven.graph.rtl_utils import extract_rtl_ports
+    result = set()
+    for config in configs or []:
+        bfm = BFMConfig(**config) if isinstance(config,dict) else config
+        source = BFMRenderer().render(bfm)
+        ports = extract_rtl_ports(re.sub(r'\binterface\b','module',source,count=1),bfm.protocol+'_bfm')
+        driven = {p['name'] for p in ports if p['direction'] in ('output','inout')}
+        result.update(actual for logical,actual in bfm.signals.items() if logical in driven)
+    return result
+
+
+def validate(dsl, api, unwritable_fields=()):
+    errors = []
+    for seq in dsl.sequences:
+        for step in list(seq.init_steps or []) + list(seq.steps):
+            if step.type == 'randomize_send':
+                referenced = set(re.findall(r'\b[A-Za-z_]\w*\b',' '.join(step.constraints)))
+                ignored = referenced & set(unwritable_fields)
+                if ignored:
+                    errors.append(f'{seq.name}/{step.name}: transaction cannot drive external/environment-owned fields {sorted(ignored)}; use the installed BFM task API, not item constraints')
+            if step.type != 'bfm_action': continue
+            signature = api.get(step.bfm,{}).get(step.action)
+            if signature is None:
+                errors.append(f'{seq.name}/{step.name}: unavailable BFM action {step.bfm}.{step.action}; installed tasks: {api.get(step.bfm,{})}')
+            elif set(step.params) != {p['name'] for p in signature}:
+                errors.append(f'{seq.name}/{step.name}: BFM parameter names must be {[p["name"] for p in signature]}')
+    if errors:
+        raise ValueError('; '.join(errors))
