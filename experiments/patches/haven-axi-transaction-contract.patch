+"""IO/electrical ownership metadata, not design behavior or test scenarios."""
+from copy import deepcopy
+import re
+
+
+def static_integer(value, width):
+    """Normalize a known unsigned SV literal without truncating its value."""
+    if type(width) is not int or width < 1:
+        raise ValueError('invalid static pin width')
+    if isinstance(value,str):
+        raw=value.strip().replace('_','')
+        if raw in ("'0","'1"):
+            value=0 if raw=="'0" else (1<<width)-1
+        else:
+            match=re.fullmatch(r"([1-9][0-9]*)'([bBoOdDhH])([0-9a-fA-F]+)",raw)
+            if match:
+                value=int(match[3],{'b':2,'o':8,'d':10,'h':16}[match[2].lower()])
+                if value >= 1<<int(match[1]): raise ValueError('static literal would truncate')
+            elif re.fullmatch(r'[0-9]+',raw): value=int(raw)
+            else: raise ValueError('static input requires a known integer literal')
+    if type(value) is not int or not 0 <= value < 1<<width:
+        raise ValueError('static input exceeds pin width')
+    return value
+
+
+def normalize_environment(blueprint, task=None):
+    result = deepcopy(blueprint)
+    io = result['io_specification']
+    inputs = {p['name']: p for p in io.get('inputs', [])}
+    outputs = {p['name']: p for p in io.get('outputs', [])}
+    ports = {**inputs, **outputs, **{p['name']: p for p in io.get('inouts', [])}}
+    if task:
+        for key in ('static_signals', 'extra_resets', 'clock_schedule'):
+            if key in task:
+                result[key] = deepcopy(task[key]) if task[key] is not None else ({} if key=='static_signals' else [])
+    infrastructure = {}
+    clock_ports = {result.get('clock', {}).get('port')} | {c['name'] for c in io.get('clocks', [])}
+    clock_ports |= {c['port'] for c in result.get('clock_schedule', []) or []}
+    for name in clock_ports - {None}:
+        infrastructure[name] = 'environment:clock'
+    infrastructure[result['reset']['name']] = 'environment:reset'
+    for reset in result.get('extra_resets', []) or []:
+        name = reset['signal']
+        if name not in inputs or inputs[name]['width'] != 1 or reset.get('level') not in ('low','high'):
+            raise ValueError('secondary reset does not identify a scalar RTL input and polarity')
+        if name in infrastructure:
+            raise ValueError('secondary reset conflicts with primary clock/reset')
+        infrastructure[name] = 'environment:reset'
+    for name in result.get('static_signals', {}) or {}:
+        if name not in inputs or name in infrastructure:
+            raise ValueError('static signal has invalid or conflicting ownership')
+        infrastructure[name] = 'environment:static'
+        result['static_signals'][name] = static_integer(result['static_signals'][name],inputs[name]['width'])
+    # Elaborated clock/reset roles are authoritative, including secondary clocks
+    # whose names do not match the legacy primary-clock heuristic. They remain
+    # real interface pins, but are not random transaction fields.
+    fields = result.get('data_contracts', {}).get('seq_item_fields')
+    if fields is not None:
+        bus = (result.get('protocol_flows') or {}).get('bus_field_mapping') or {}
+        if all(bus.get(k) for k in ('cyc','stb','ack','addr')):
+            from haven.utils.protocol_driver_renderer import _build_bus_context
+            width = _build_bus_context(result)['addr_width']
+            for field in fields:
+                if field.get('name') == bus['addr']:
+                    field['width'] = width
+        result['data_contracts']['seq_item_fields'] = [f for f in fields
+            if infrastructure.get(f.get('name')) not in ('environment:clock', 'environment:reset')]
+        # A register read needs a response slot even when the planner listed
+        # only input payload fields. Derive its width/direction from real IO.
+        read_data = (result.get('protocol_flows') or {}).get('bus_field_mapping') or {}
+        read_data = read_data.get('read_data')
+        if read_data in outputs:
+            fields = result['data_contracts']['seq_item_fields']
+            response = next((f for f in fields if f.get('name')==read_data),None)
+            if response is None:
+                response = {'name':read_data,'type':'logic'}
+                fields.append(response)
+            response.update(width=outputs[read_data]['width'],direction='output',is_rand=False)
+    aliases = {'txd': 'tx', 'rxd': 'rx'}
+    from haven.dsl.schema import BFMConfig
+    from haven.utils.bfm_renderer import BFMRenderer
+    from haven.graph.rtl_utils import extract_rtl_ports
+    bfms, owners, pads, corrections = [], {}, [], []
+    for raw in result.get('bfm_configs') or []:
+        bfm = BFMConfig(**raw)
+        code = BFMRenderer().render(bfm)
+        # The generic RTL parser handles interface port declarations after this
+        # lexical header substitution; BFM behavior is never inspected/rewritten.
+        declarations = extract_rtl_ports(re.sub(r'\binterface\b', 'module', code, count=1), bfm.protocol + '_bfm')
+        logical = {p['name']: p for p in declarations if p['name'] not in ('clk', 'rst')}
+        # Optional adapter ports already declare safe defaults in the native
+        # template. Keep them optional when normalizing a saved environment;
+        # never invent defaults for required device pins.
+        header = code[:code.index(');')]
+        defaults = dict(re.findall(r'\binput\s+logic\s+(?:\[[^]]+\]\s*)?(\w+)\s*=\s*([0-9]+)\s*(?=,|$)', header, re.M))
+        for name, value in defaults.items():
+            if name not in bfm.signals:
+                bfm.params.setdefault('port_defaults', {}).setdefault(name,value)
+        signals = {}
+        for name, actual in bfm.signals.items():
+            name = aliases.get(name, name) if bfm.protocol == 'uart_serial' else name
+            if name not in logical:
+                corrections.append(f'{bfm.protocol}: discard nonexistent BFM port {name}; DUT pin {actual} remains available to its agent')
+                continue
+            if actual not in ports:
+                raise ValueError(f'BFM {bfm.protocol}.{name} maps unknown RTL port {actual}')
+            if int(logical[name]['width']) != int(ports[actual]['width']):
+                raise ValueError(f'BFM {bfm.protocol}.{name} width differs from RTL port {actual}')
+            if name in signals and signals[name] != actual:
+                raise ValueError(f'BFM {bfm.protocol}.{name} has ambiguous aliases')
+            signals[name] = actual
+            direction = logical[name]['direction']
+            # Split open-drain RTL IO stays split; the resolved physical wire is
+            # a separate testbench net with a pullup and explicit output enable.
+            if actual.endswith('_pad_i') and actual in inputs:
+                stem = actual[:-len('_pad_i')]
+                value, enable = stem + '_pad_o', stem + '_padoen_o'
+                if value in outputs and enable in outputs:
+                    if any(int(ports[n]['width']) != 1 for n in (actual, value, enable)):
+                        raise ValueError('open-drain pad bundle must be scalar')
+                    pad = {'input': actual, 'output': value, 'enable_n': enable,
+                           'net': 'env_pad_' + stem}
+                    if pad not in pads:
+                        pads.append(pad)
+                    # The pullup/DUT output-enable network owns even a pad that
+                    # the BFM only observes (e.g. slave SCL); no active driver may
+                    # simultaneously drive the split input variable.
+                    if direction == 'input':
+                        infrastructure[actual] = 'environment:pad'
+            if direction in ('output', 'inout'):
+                if actual in outputs:
+                    raise ValueError(f'BFM {bfm.protocol}.{name} would drive DUT output {actual}')
+                if actual in owners:
+                    raise ValueError(f'multiple BFMs drive {actual}')
+                if actual in infrastructure and infrastructure[actual] != 'environment:clock':
+                    raise ValueError(f'BFM conflicts with infrastructure owner of {actual}')
+                owners[actual] = 'bfm:' + bfm.protocol
+                infrastructure.pop(actual, None)
+        missing = set(logical) - signals.keys() - (bfm.params.get('port_defaults') or {}).keys()
+        if missing:
+            raise ValueError(f'BFM {bfm.protocol} has unmapped ports: {sorted(missing)}')
+        bfm.signals = signals
+        bfms.append(bfm.model_dump())
+    result['bfm_configs'] = bfms
+    result['open_drain_connections'] = pads
+    result['feedback_connections'] = [
+        {'input':b['signals']['gpio_in'],'output':b['signals']['gpio_out'],'enable':b['signals']['gpio_oe']}
+        for b in bfms if b['protocol']=='gpio']
+    agents = result.get('topology', {}).get('agents', []) or []
+    agent_owners = {}
+    modes = {'master': 'active', 'active_master': 'active', 'slave': 'reactive', 'active_slave': 'reactive',
+             'monitor': 'passive', 'observer': 'passive'}
+    for agent in agents:
+        agent['mode'] = modes.get(agent.get('mode', 'active'), agent.get('mode', 'active'))
+        if agent['mode'] not in ('active', 'reactive', 'passive'):
+            raise ValueError(f'unsupported agent mode: {agent["mode"]}')
+        signals = set(agent.get('input_signals', [])) | set(agent.get('output_signals', [])) | set(agent.get('observed_environment_inputs', []))
+        driven = sorted((signals & inputs.keys()) - owners.keys() - infrastructure.keys())
+        agent['input_signals'] = driven
+        agent['output_signals'] = sorted(signals & outputs.keys())
+        agent['observed_environment_inputs'] = sorted(signals & (owners.keys() | infrastructure.keys()))
+        if agent['mode'] != 'passive' and not driven:
+            agent['mode'] = 'passive'
+            corrections.append(f'{agent["name"]}: BFM owns all stimulus pins; retain agent as passive observer')
+        if agent['mode'] != 'passive':
+            for pin in driven:
+                if pin in agent_owners:
+                    raise ValueError(f'multiple agents claim {pin}: {agent_owners[pin]}, {agent["name"]}')
+                agent_owners[pin] = agent['name']
+    if result.get('protocol_flows'):
+        result['protocol_flows']['bfm_configs'] = bfms
+    result['environment_contract'] = {'version': 'pin-ownership-v1', 'bfm_owned': owners,
+                                      'agent_owned': agent_owners, 'infrastructure_owned': infrastructure,
+                                      'corrections': corrections}
+    active = [a for a in agents if a['mode']=='active']
+    if len(active)>1:
+        bus = (result.get('protocol_flows') or {}).get('bus_field_mapping') or {}
+        bus_pins = {bus.get(k) for k in ('cyc','stb','awvalid','arvalid','addr')} - {None,''}
+        primary = [a for a in active if bus_pins & set(a['input_signals'])]
+        if len(primary)!=1:
+            raise ValueError('multiple active agents need one unambiguous primary transaction bus')
+        result['sequence_dispatch'] = {'version':'broadcast-disjoint-pins-v1','primary':primary[0]['name'],
+                                      'secondary':[a['name'] for a in active if a!=primary[0]]}
+    return result
+
+
+def validate_driver_ownership(code, agent, blueprint):
+    """Reject conflicting writes instead of silently deleting model behavior."""
+    contract = blueprint.get('environment_contract')
+    if not contract:
+        return []
+    code = re.sub(r'//[^\n]*|/\*.*?\*/|"(?:\\.|[^"\\])*"', ' ', code, flags=re.S)
+    writes = set(re.findall(r'\bvif\.(\w+)(?:\s*\[[^]]+\])?\s*(?:<=(?!=)|=(?!=)|[+*/&|^%-]=|\+\+|--)', code))
+    owners = {**contract['agent_owned'], **contract['bfm_owned'], **contract.get('infrastructure_owned', {})}
+    return [f'{agent} must not write {pin}; declared owner is {owners.get(pin, "not this agent")}'
+            for pin in sorted(writes) if owners.get(pin) != agent]
