+from types import SimpleNamespace
+from unittest.mock import patch
+
+from haven.eda.vcs_utils import vcs_simulate, extract_sim_errors
+from haven.dsl.codegen import normalize_sv_hex, DSLCodegen
+from haven.dsl.schema import DSLSequenceSet, BusFieldMapping
+
+
+def test_stage2_resume_prefers_compiled_phase5_and_preserves_explicit_final(tmp_path):
+    from haven.main import _load_state_from_ir
+    (tmp_path/'phase3_components').mkdir()
+    (tmp_path/'phase3_components/driver.sv').write_text('old')
+    (tmp_path/'phase5_components').mkdir()
+    (tmp_path/'phase5_components/driver.sv').write_text('compiled')
+    (tmp_path/'phase5_components/subscriber.sv').write_text('compiled subscriber')
+    (tmp_path/'phase5_sequences').mkdir()
+    for number in (1, 2, 10):
+        (tmp_path/f'phase5_sequences/sequence_{number}.sv').write_text(str(number))
+    state = {'task': {'root':str(tmp_path), 'spec':'missing_spec'}}
+    loaded = _load_state_from_ir(state,tmp_path,6)
+    assert loaded['components'] == {'driver':'compiled','subscriber':'compiled subscriber'}
+    assert loaded['sequences'] == ['1','2','10']
+    loaded['components'] = {'driver':'explicit final'}
+    loaded['sequences'] = ['explicit final']
+    again = _load_state_from_ir(loaded,tmp_path,6)
+    assert again['components'] == {'driver':'explicit final'}
+    assert again['sequences'] == ['explicit final']
+
+
+def test_zero_exit_with_uvm_error_is_not_success():
+    clean = 'UVM_ERROR : 0\nUVM_FATAL : 0\n'
+    for text, ok in ((clean, True), ('UVM_ERROR seq.sv(12) [poll] Poll timeout\n' + clean, False),
+                     ('UVM_ERROR : 1\nUVM_FATAL : 0\n', False), ('', False),
+                     ('UVM_FATAL [PH_TIMEOUT] hung\n' + clean, False)):
+        with patch('haven.eda.vcs_utils.run_eda_command', return_value=SimpleNamespace(returncode=0, stdout=text, stderr='')):
+            assert vcs_simulate(cwd='.', config={}, module_name='synthetic')['ok'] is ok
+    assert extract_sim_errors(clean) == []
+    assert extract_sim_errors('UVM_INFO [test] testing error handling\n') == []
+
+
+def test_hex_conversion_is_value_preserving_and_does_not_touch_comments_or_strings():
+    source = 'x = 0x14; y = 0XFFFF_FFFF; z = 8\'h12; x0x14 = 1; "0x14"; // 0x14\n/* 0x22 */'
+    expected = 'x = \'h14; y = \'hFFFF_FFFF; z = 8\'h12; x0x14 = 1; "0x14"; // 0x14\n/* 0x22 */'
+    assert normalize_sv_hex(source) == expected
+    assert normalize_sv_hex(expected) == expected
+    dsl = DSLSequenceSet.model_validate({'module_name':'synthetic','sequences':[
+        {'name':'write_one','description':'generic literal syntax','steps':[
+            {'type':'register_write','name':'write','addr':'0x14','value':'0x1234'}]}]})
+    mapping = BusFieldMapping(addr='addr',data='data',we='we',read_data='result')
+    code = DSLCodegen().generate(dsl,mapping)[0]
+    assert "txn.addr = 'h14;" in code and "txn.data = 'h1234;" in code
