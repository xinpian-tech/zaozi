+"""Field ownership for the fixed AXI-Lite transaction driver (not cycle stimulus).
+
+Derived from the explicit bus mapping, never signal-name heuristics or DUT answers.
+The driver accepts five item fields; handshake/protection pins are driver-owned.
+Unsupported timing goals must be rejected, not silently dropped from a sequence.
+"""
+from copy import deepcopy
+import re
+
+VERSION = "axi4lite-transaction-v1"
+
+
+def apply_transaction_contract(blueprint):
+    mapping = (blueprint.get("protocol_flows") or {}).get("bus_field_mapping") or {}
+    if not all(mapping.get(key) for key in ("awvalid", "wvalid", "arvalid")):
+        return blueprint  # Direct IO and other driver contracts are unchanged.
+    from haven.utils.protocol_driver_renderer import _build_axi4lite_bus_context
+    bus = _build_axi4lite_bus_context(blueprint)
+    agents = blueprint.get('topology', {}).get('agents', [])
+    active = [a for a in agents if a.get('mode', 'active') != 'passive']
+    if agents and (len(active) != 1 or active[0].get('mode', 'active') not in ('active', 'active_master')):
+        raise ValueError('AXI transaction contract requires one active initiator; additional agents must be passive')
+    io = blueprint["io_specification"]
+    inputs = {p["name"]: p for p in io.get("inputs", [])}
+    outputs = {p["name"]: p for p in io.get("outputs", [])}
+    infra = {blueprint["clock"]["port"], blueprint["reset"]["name"]}
+    driver_roles = ("awvalid", "wvalid", "arvalid", "bready", "rready", "awprot", "arprot")
+    driver_owned = {bus[k] for k in driver_roles if bus.get(k)}
+    for key in ('awaddr', 'wdata', 'wstrb', 'araddr', 'we', 'data', 'read_data'):
+        if not bus.get(key):
+            raise ValueError(f'AXI transaction contract is missing {key}')
+    for key in ("awaddr", "wdata", "wstrb", "araddr", *driver_roles):
+        if bus.get(key) and bus[key] not in inputs:
+            raise ValueError(f"AXI transaction contract: {key} is not an input port")
+    for key in ("awready", "wready", "bvalid", "bresp", "arready", "rvalid", "rdata", "rresp"):
+        if not bus.get(key) or bus[key] not in outputs:
+            raise ValueError(f"AXI transaction contract: {key} is not an output port")
+    # External BFMs and static/reset/clock infrastructure retain pin ownership;
+    # they are not missing AXI driver payload. Verify rather than trust supplied
+    # ownership labels before exempting those pins from the driver contract.
+    from haven.utils.environment_contract import normalize_environment
+    normalized = normalize_environment(blueprint)
+    environment = normalized['environment_contract']
+    external = set(environment['bfm_owned']) | set(environment['infrastructure_owned'])
+    unmapped = set(inputs) - infra - driver_owned - external - {bus[k] for k in ("awaddr", "wdata", "wstrb", "araddr")}
+    if unmapped:
+        raise ValueError(f"AXI driver does not drive extra input ports: {sorted(unmapped)}")
+    payload = {bus["we"]: 1, bus["awaddr"]: int(inputs[bus["awaddr"]]["width"]),
+               bus["data"]: int(inputs[bus["wdata"]]["width"]),
+               bus["wstrb"]: int(inputs[bus["wstrb"]]["width"]),
+               bus["araddr"]: int(inputs[bus["araddr"]]["width"])}
+    if len(payload) != 5 or any(not re.fullmatch(r"[A-Za-z_]\w*", name) for name in payload):
+        raise ValueError("AXI driver needs five distinct, valid transaction field names")
+    if set(payload) & (driver_owned | set(outputs) | infra):
+        raise ValueError("AXI payload field conflicts with a driver/output/infrastructure signal")
+    if bus['read_data'] in payload or bus['read_data'] in driver_owned:
+        raise ValueError('AXI read-data observation aliases a writable/driver-owned field')
+    if (int(inputs[bus['awaddr']]['width']) != int(inputs[bus['araddr']]['width'])
+            or int(inputs[bus['wdata']]['width']) != int(outputs[bus['rdata']]['width'])
+            or int(inputs[bus['wstrb']]['width']) * 8 != int(inputs[bus['wdata']]['width'])):
+        raise ValueError('AXI driver requires matching address/data widths and one strobe per byte')
+    fields = {p["name"]: {"name": p["name"], "type": "logic", "width": int(p["width"]),
+                "direction": direction, "is_rand": False, "constraints": [],
+                "owner": "driver" if p["name"] in driver_owned else "observation",
+                "transaction_contract": VERSION}
+              for direction, ports in (("input", inputs.values()), ("output", outputs.values()))
+              for p in ports if p["name"] not in infra}
+    fields[bus["read_data"]] = {"name": bus["read_data"], "type": "logic",
+        "width": int(outputs[bus["rdata"]]["width"]), "direction": "output", "is_rand": False,
+        "constraints": [], "owner": "observation", "transaction_contract": VERSION}
+    for name, width in payload.items():
+        fields[name] = {"name": name, "type": "logic", "width": width, "direction": "input",
+                       "is_rand": True, "constraints": [], "owner": "sequence", "transaction_contract": VERSION}
+    result = deepcopy(blueprint)
+    result.setdefault("data_contracts", {})["seq_item_fields"] = list(fields.values())
+    result["transaction_contract"] = {"version": VERSION, "randomizable": sorted(payload),
+        "driver_owned": sorted(driver_owned),
+        "timing": "Driver launches AW/W together and controls VALID/READY; per-channel delays and backpressure are not item parameters.",
+        "constraint_policy": "No default scenario constraints; only declared sequence-owned fields may be constrained."}
+    return result
+
+
+def validate_item_contract(code, fields):
+    """Conservative validation of the flat field-only transaction item subset."""
+    if not any(f.get("transaction_contract") == VERSION for f in fields):
+        return []
+    code = re.sub(r'//[^\n]*|/\*.*?\*/|"(?:\\.|[^"\\])*"', ' ', code, flags=re.S)
+    errors = []
+    for f in fields:
+        declaration = re.search(rf"\b(?:(randc|rand)\s+)?(logic|bit)\s*(?:\[(\d+):0\]\s*)?{re.escape(f['name'])}\s*;", code)
+        if not declaration:
+            errors.append(f"Declare {f['name']} as a flat logic/bit field of width {f['width']}")
+            continue
+        width = int(declaration[3]) + 1 if declaration[3] else 1
+        if width != f['width'] or bool(declaration[1]) != f['is_rand'] or declaration[1] == 'randc':
+            errors.append(f"Field {f['name']}: expected width={f['width']}, rand={f['is_rand']} (owner={f['owner']})")
+    allowed = {f['name'] for f in fields if f['is_rand']}
+    for declaration in re.finditer(r"\b(?:randc|rand)\b[^;]*;", code):
+        names = re.findall(r"[A-Za-z_]\w*", declaration.group())
+        if not names or names[-1] not in allowed or ',' in declaration.group():
+            errors.append("Undeclared randomization parameter: only the driver contract's payload fields are writable")
+    if re.search(r"\bconstraint\b|\b(?:pre_randomize|post_randomize)\s*\(", code):
+        errors.append("AXI transaction item must not impose scenario constraints or randomization hooks; put payload choices in sequences")
+    return errors
+
+
+def validate_dsl_contract(dsl, fields):
+    if not any(f.get("transaction_contract") == VERSION for f in fields):
+        return
+    observed = {f['name'] for f in fields if not f['is_rand']}
+    allowed = {f['name'] for f in fields if f['is_rand']}
+    for seq in dsl.sequences:
+        for step in [*(seq.init_steps or []), *seq.steps]:
+            for constraint in getattr(step, 'constraints', []) or []:
+                ids = set(re.findall(r"\b[A-Za-z_]\w*\b", constraint))
+                bad = ids & observed
+                # A payload-only contract has no enum aliases; reject unknown LHS too.
+                lhs = re.match(r"\s*(?:txn\.)?([A-Za-z_]\w*)", constraint)
+                if bad or (lhs and lhs[1] not in allowed):
+                    raise ValueError(f"Sequence {seq.name}: unsupported transaction constraint {constraint!r}; "
+                        f"only {sorted(allowed)} drive this AXI item; handshake timing is driver-owned")
