+import pytest
+from haven.utils.bfm_api import available, validate, extract
+from haven.dsl.schema import DSLSequenceSet
+
+
+def sequence(action='send_byte',params=None):
+    return DSLSequenceSet.model_validate({'module_name':'probe','sequences':[{
+        'name':'generic','description':'generic','function_point':'generic','steps':[{
+            'type':'bfm_action','name':'invoke','bfm':'uart_serial','action':action,
+            'params':{'data':"8'h2a"} if params is None else params}]}]})
+
+
+def test_unknown_actions_and_wrong_argument_names_fail_before_codegen():
+    api = available([{'protocol':'uart_serial','signals':{},'params':{}}])
+    assert api['uart_serial']['send_byte'] == [{'name':'data','direction':'input','type':'logic [7:0]'}]
+    validate(sequence(),api)
+    with pytest.raises(ValueError,match='unavailable BFM action'):
+        validate(sequence('invented_action'),api)
+    with pytest.raises(ValueError,match='parameter names'):
+        validate(sequence(params={'invented':'1'}),api)
+
+
+def test_only_real_task_declarations_are_exported():
+    assert extract({'generic':'// task invented(input bit x);\n task automatic actual(input bit x); endtask'}) == {
+        'generic':{'actual':[{'name':'x','direction':'input','type':'bit'}]}}
+
+
+def test_gpio_api_and_ignored_item_constraints():
+    from haven.utils.bfm_api import owned_fields
+    assert owned_fields([{'protocol':'gpio','signals':{'gpio_in':'pins','gpio_out':'out','gpio_oe':'oe'},'params':{}}]) == {'pins'}
+    api = available([{'protocol':'gpio','signals':{},'params':{'width':7}}])
+    assert api['gpio']['set_input'] == [{'name':'value','direction':'input','type':'logic [WIDTH-1:0]'}]
+    dsl = sequence()
+    raw = dsl.model_dump()
+    raw['sequences'][0]['steps'] = [{'type':'randomize_send','name':'wrong_owner','repeat':1,'constraints':['external_pin == 7'] }]
+    with pytest.raises(ValueError,match='cannot drive external/environment-owned'):
+        validate(DSLSequenceSet.model_validate(raw),api,['external_pin'])
