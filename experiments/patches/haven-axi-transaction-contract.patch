+import json
+import pytest
+from haven.utils.json_output import loads
+
+
+def test_typed_object_envelope_preserves_payload():
+    payload={'module_name':'synthetic','topology':{'agents':[]}}
+    for content in (payload,json.dumps(payload)):
+        assert loads(json.dumps({'type':'json_object','content':content})) == payload
+    plain={'content':payload,'application':'keep'}
+    assert loads(json.dumps(plain)) == plain
+    with pytest.raises(ValueError,match='must be an object'):
+        loads('{"type":"json_object","content":[]}')
+
+
+def test_hex_numbers_preserve_values_and_strings():
+    assert loads('{"positive":0x15,"negative":-0xA,"array":[0XFF,0x0],"text":"0x15, \\\"0xF\\\""}') == {
+        'positive':21,'negative':-10,'array':[255,0],'text':'0x15, "0xF"'}
+
+
+def test_known_unsigned_sv_integer_representation_only():
+    assert loads('''{"a":32'h1,"b":8'b1010,"c":8'o12,"d":8'd10,"text":"32'h1"}''') == {
+        'a':1,'b':10,'c':10,'d':10,'text':"32'h1"}
+    for raw in ["4'hFF","8'shFF","8'hxz","-8'h1","8'b222","100000'h1"]:
+        with pytest.raises(json.JSONDecodeError):
+            loads('{"a":'+raw+'}')
+
+
+@pytest.mark.parametrize('text',['{"a":0xG}', '{"a":foo0x15}', '{"a":0x15 + 1}',
+                                '{"a":0x1,}', '{"a":0x1 // comment\n}', '{"a":NaN garbage}'])
+def test_no_general_syntax_or_expression_repair(text):
+    with pytest.raises(json.JSONDecodeError):
+        loads(text)
