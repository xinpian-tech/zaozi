+def blueprint():
+    widths = {'awaddr': 16, 'wdata': 32, 'wstrb': 4, 'araddr': 16, 'rdata': 32,
+              'bresp': 2, 'rresp': 2}
+    # Nonstandard names ensure ownership does not depend on suffix regexes.
+    keys = ('awaddr', 'awvalid', 'awready', 'wdata', 'wvalid', 'wready', 'wstrb',
+            'bresp', 'bvalid', 'bready', 'araddr', 'arvalid', 'arready', 'rdata', 'rvalid', 'rready', 'rresp')
+    mapping = {key: f'pin_{i}' for i, key in enumerate(keys)}
+    ins = {'awaddr', 'awvalid', 'wdata', 'wvalid', 'wstrb', 'bready', 'araddr', 'arvalid', 'rready'}
+    mapping.update(addr=mapping['awaddr'], data=mapping['wdata'], we='write_op', read_data=mapping['rdata'])
+    return {'module_name': 'synthetic', 'clock': {'port': 'clk'}, 'reset': {'name': 'rst', 'level': 'high'},
+            'io_specification': {direction: [{'name': mapping[key], 'width': widths.get(key, 1)}
+                 for key in keys if (key in ins) == (direction == 'inputs')] for direction in ('inputs', 'outputs')},
+            'protocol_flows': {'bus_field_mapping': mapping},
+            'data_contracts': {'seq_item_fields': [{'name': 'kind', 'is_rand': True, 'constraints': ['kind == WRITE']}]}}
+
+
+def item(bp):
+    fields = bp['data_contracts']['seq_item_fields']
+    return ('class synthetic_seq_item extends uvm_sequence_item;\n'
+            '  `uvm_object_utils(synthetic_seq_item)\n' + ''.join(
+                f"  {'rand ' if f['is_rand'] else ''}logic [{f['width']-1}:0] {f['name']};\n" for f in fields)
+            + '  function new(string name="synthetic_seq_item"); super.new(name); endfunction\nendclass\n')
+
+
+def test_external_bfm_inputs_are_not_axi_payload_or_missing_driver_pins():
+    bp=blueprint()
+    bp['io_specification']['inputs'].append({'name':'serial_rx','width':1})
+    bp['io_specification']['outputs'].append({'name':'serial_tx','width':1})
+    bp['bfm_configs']=[{'protocol':'uart_serial','signals':{'rx':'serial_rx','tx':'serial_tx'},'params':{}}]
+    fixed=apply_transaction_contract(bp)
+    assert 'serial_rx' not in fixed['transaction_contract']['randomizable']
+    driver=ProtocolDriverRenderer().render_driver(fixed)
+    assert 'vif.serial_rx <=' not in driver
+    del bp['bfm_configs']
+    bp['environment_contract']={'bfm_owned':{'serial_rx':'bfm:invented'}}
+    with pytest.raises(ValueError,match='extra input ports'):
+        apply_transaction_contract(bp)
+
+
