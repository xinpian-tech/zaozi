package build.experiments

import mill._
import mill.scalalib._
import mill.scalalib.TestModule.Utest
import mill.scalalib.scalafmt._

import build.{circtlib, utlib, v, zaozi, ZaoziScalaModule}

/** Generic sequence experiments. Per-run Scala sources are explicit build inputs, never a shared source slot.
  * No design-specific stdlib or historical UT is on the active experiment's classpath.
  */
object `package` extends ZaoziScalaModule with ScalafmtModule { m =>
  def scalaVersion = Task(v.scala)
  def moduleDeps   = Seq(zaozi, utlib)

  def runSources: T[Seq[PathRef]] = Task.Input {
    Task.env.get("RVPROBE_EXPERIMENT_SOURCES").toSeq.map(p => PathRef(os.Path(p)))
  }
  override def sources: T[Seq[PathRef]] = Task(super.sources() ++ runSources())

  override def scalacOptions: T[Seq[String]] = Task(super.scalacOptions() ++ Seq("-experimental"))

  override def forkArgs: T[Seq[String]] = Task(
    super.forkArgs() ++ circtlib.forkArgs()
  )

  // Framework RAG examples are compiled with the runner; these tests use no solver or provider.
  object tests extends ScalaTests with Utest {
    def mvnDeps = Seq(v.utest)
    override def moduleDeps: Seq[JavaModule] = Seq(m)
    override def scalacOptions: T[Seq[String]] = Task(super.scalacOptions() ++ Seq("-experimental"))
    override def forkArgs: T[Seq[String]] = Task(super.forkArgs() ++ circtlib.forkArgs())
  }
}
