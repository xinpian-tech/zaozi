package build.zaozi

import mill._
import mill.scalalib.TestModule.Utest
import mill.scalalib._
import mill.scalalib.scalafmt._
import os.Path

import build.{circtlib, v, LitModule, ZaoziPublishModule, ZaoziScalaModule}
import build.testlib

object `package` extends ZaoziScalaModule with ScalafmtModule with ZaoziPublishModule { m =>

  def mvnDeps    = Seq(v.mainargs, v.oslib, v.upickle, v.sourcecode)
  def moduleDeps = Seq(circtlib)

  // Due to a bug of macro in utest, we have to disable -Xcheck-macros to make dotty happy
  override def scalacOptions: T[Seq[String]] = Task(
    super.scalacOptions() ++ Seq("-Xprint-suspension", "-experimental", "-Xcheck-macros")
  )

  object lit extends ZaoziScalaModule with ScalafmtModule {

    def moduleDeps = Seq(m)
    object tests extends LitModule {
      def scalaVersion: T[String]       = Task(m.scalaVersion())
      def runClasspath: T[Seq[os.Path]] = Task(lit.runClasspath().map(_.path))
      def nativeInstalls = circtlib.nativeInstalls()
      def litDir:      T[os.Path] = Task(moduleDir)
      def litConfigIn: T[PathRef] = Task.Source(moduleDir / "lit.site.cfg.py.in")
    }
  }

  object benchmark extends ZaoziScalaModule {
    def moduleDeps             = Seq(m)
    override def scalacOptions = Task(super.scalacOptions() :+ "-experimental")
    override def mainClass     = Task(Some("me.jiuyang.zaozi.benchmark.ZaoziBenchmark"))
  }

  object tests extends NativeTests with ScalafmtModule with Utest {
    override def scalacOptions: T[Seq[String]] = Task(super.scalacOptions().filterNot(_ == "-Xcheck-macros"))

    override def mvnDeps = super.mvnDeps() ++ Seq(v.utest)
    def moduleDeps       = Seq(testlib)

  }

  object opt extends ZaoziScalaModule {
    def moduleDeps         = Seq(m)
    override def mainClass = Task(Some("me.jiuyang.zaozi.tools.ZaoziOpt"))
  }
}
