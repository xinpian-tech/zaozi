  [#syn-diagram(spacing: (7mm, 3.6mm), node((0.7, 0), [比], name: <j>), edge((0, -0.45), <j>, "-|>"), edge((0, -0.15), <j>, "-|>"), edge((0, 0.15), <j>, "-|>"), edge((0, 0.45), <j>, "-|>"), edge(<j>, (1.4, -0.2), "-|>"), edge(<j>, (1.4, 0.2), "-|>"))],
