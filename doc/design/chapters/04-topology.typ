  [下行参数逐边取自参数表；无上行输出。],
  [*汇*（sink）],
  [#syn-diagram(spacing: (8mm, 5mm), node((0.8, 0), [汇], name: <k>), edge((0, -0.35), <k>, "-|>"), edge((0, 0.35), <k>, "-|>"))],
