    node((-0.85, 2), `汇 :=* 源`, stroke: none),
    node((0, 2), [源], name: <s3>, fill: rgb("#fdf3d7")),
    node((1, 2), [汇], name: <k3>),
    edge(<s3>, <k3>, "-|>", label: text(size: 8pt)[边数 $=$ 源的解]),
