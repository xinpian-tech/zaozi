package build.circtlib

import mill._
import mill.scalalib._
import mill.scalalib.TestModule.Utest
import mill.scalalib.scalafmt._

import build.{v, RawBindingsModule, ZaoziPublishModule, ZaoziScalaModule}

object `package` extends ZaoziScalaModule with ScalafmtModule with ZaoziPublishModule {
  object raw extends RawBindingsModule {
    def group      = "circt"
    def moduleDeps = Seq(build.mlirlib.raw)
  }
  def moduleDeps = Seq(raw, build.mlirlib)
  def mvnDeps = Seq(v.mainargs, v.pprint, v.upickle)
  object tests extends NativeTests with ScalafmtModule with Utest {
    override def mvnDeps = super.mvnDeps() ++ Seq(v.utest, v.oslib, v.upickle)
  }
}
