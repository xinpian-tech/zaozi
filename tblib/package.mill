package build.tblib

import mill._
import mill.scalalib._
import mill.scalalib.scalafmt._

import build.{stdlib, v, zaozi}

object `package` extends ScalaModule with ScalafmtModule {
  def scalaVersion = Task(v.scala)
  def moduleDeps = Seq(zaozi, stdlib)
  override def scalacOptions: T[Seq[String]] = Task(super.scalacOptions() :+ "-experimental")
}
